<%- include('../partials/_navbar.ejs') %>

<h1>Edit Recipe</h1>

<form action="/recipes/<%= recipe._id %>?_method=PUT" method="POST">
  <label for="name">Recipe Name</label>
  <input type="text" name="name" id="name" value="<%= recipe.name %>" required>

  <label for="instructions">Instructions</label>
  <textarea name="instructions" id="instructions" rows="6"><%= recipe.instructions %></textarea>

  <fieldset>
    <legend>Ingredients</legend>
    <% ingredients.forEach(function(ingredient) { %>
      <label>
        <input
          type="checkbox"
          name="ingredients"
          value="<%= ingredient._id %>"
          <% if (recipe.ingredients.some(function(i) { return i.equals(ingredient._id); })) { %> checked <% } %>
        >
        <%= ingredient.name %>
      </label>
      <br>
    <% }) %>
  </fieldset>

  <button type="submit">Save Changes</button>
</form>

<a href="/recipes/<%= recipe._id %>">Cancel</a>