<%- include('../partials/_navbar.ejs') %>

<h1>Add New Recipe</h1>

<form action="/recipes" method="POST">
  <label for="name">Recipe Name</label>
  <input type="text" name="name" id="name" required>

  <label for="instructions">Instructions</label>
  <textarea name="instructions" id="instructions" rows="6"></textarea>

  <fieldset>
    <legend>Ingredients</legend>
    <% if (ingredients.length === 0) { %>
      <p>No ingredients yet. <a href="/foods/ingredients/new">Add one</a> first.</p>
    <% } else { %>
      <% ingredients.forEach(function(ingredient) { %>
        <label>
          <input type="checkbox" name="ingredients" value="<%= ingredient._id %>">
          <%= ingredient.name %>
        </label>
        <br>
      <% }) %>
    <% } %>
  </fieldset>

  <a href="/foods/ingredients/new">+ Add a new ingredient</a>

  <button type="submit">Save Recipe</button>
</form>

<a href="/recipes">Back to My Recipes</a>