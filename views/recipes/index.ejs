<%- include('../partials/_navbar.ejs') %>

<h1>My Recipes</h1>

<a href="/recipes/new">Add New Recipe</a>

<% if (recipes.length === 0) { %>
  <p>You haven't added any recipes yet.</p>
<% } else { %>
  <ul>
    <% recipes.forEach(function(recipe) { %>
      <li>
        <a href="/recipes/<%= recipe._id %>"><%= recipe.name %></a>
      </li>
    <% }) %>
  </ul>
<% } %>