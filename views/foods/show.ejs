<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= food.name %></title>
  </head>
<body>
     <h1><%= food.name %></h1>
  <%- include('../partials/_navbar.ejs') %>
     <a
            href="/users/<%= user._id %>/foods/<%= food._id %>/edit"
          >
            Show App
          </a>
         <form
            action="/users/<%= user._id %>/foods/<%= food._id %>?_method=DELETE"
            method="POST"
          >
            <button type="submit">Delete App</button>
          </form>
<a href="/users/<%=user._id%>/foods/">Back to pantry</a>
</body>
</html>