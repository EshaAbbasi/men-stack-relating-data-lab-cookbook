<%- include('../partials/_navbar.ejs') %>

<h1>My Pantry</h1>

<a href="/foods/new">Add New Item</a>

<% if (pantry.length === 0) { %>
  <p>Your pantry is empty. Start adding items!</p>
<% } else { %>
  <ul>
    <% pantry.forEach(function(food) { %>
      <li>
        <a href="/foods/<%= food._id %>"><%= food.name %></a>
      </li>
    <% }) %>
  </ul>
<% } %>