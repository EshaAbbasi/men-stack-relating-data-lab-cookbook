<%- include('../partials/_navbar.ejs') %>

<h1><%= user.username %>'s Profile</h1>

<h2>Pantry</h2>
<% if (user.pantry.length === 0) { %>
  <p><%= user.username %>'s pantry is empty.</p>
<% } else { %>
  <ul>
    <% user.pantry.forEach(function(food) { %>
      <li><%= food.name %></li>
    <% }) %>
  </ul>
<% } %>

<h2>Recipes</h2>
<% if (recipes.length === 0) { %>
  <p><%= user.username %> hasn't added any recipes yet.</p>
<% } else { %>
  <ul>
    <% recipes.forEach(function(recipe) { %>
      <li>
        <a href="/recipes/<%= recipe._id %>"><%= recipe.name %></a>
      </li>
    <% }) %>
  </ul>
<% } %>

<a href="/users">Back to All Users</a>